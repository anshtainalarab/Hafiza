<Window x:Class="Hafiza.HotKeyDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="{DynamicResource Loc_DialogHotkeyTitle}" Width="420" Height="230"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent"
        ShowInTaskbar="False" FontFamily="{StaticResource InterfaceFont}"
        PreviewKeyDown="Window_PreviewKeyDown">
    <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1" CornerRadius="18" Padding="24">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>
            <TextBlock Text="{DynamicResource Loc_DialogHotkeyTitle}" FontSize="19" FontWeight="SemiBold" Foreground="{DynamicResource PrimaryBrush}" />
            <TextBlock Grid.Row="1" Text="{DynamicResource Loc_DialogHotkeyInstructions}" Foreground="{DynamicResource SecondaryBrush}"
                       FontSize="12" Margin="0,6,0,0" />
            <Border Grid.Row="2" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}" BorderThickness="1"
                    CornerRadius="8" Height="46" Margin="0,16,0,14">
                <TextBlock x:Name="ShortcutText" Text="Press shortcut keys" Foreground="{DynamicResource PrimaryBrush}"
                           FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"
                           FlowDirection="LeftToRight" />
            </Border>
            <StackPanel Grid.Row="3" Orientation="Horizontal" HorizontalAlignment="Left">
                <Button Content="{DynamicResource Loc_DialogSave}" Width="82" Height="38" Margin="8,0,0,0" IsDefault="True"
                        Background="{DynamicResource AccentBrush}" Foreground="{DynamicResource CheckBoxMarkBrush}" BorderThickness="0" Click="Save_Click" />
                <Button Content="{DynamicResource Loc_DialogRemoveShortcut}" Width="118" Height="38" Margin="8,0,0,0"
                        Background="{DynamicResource SectionBackgroundBrush}" Foreground="{DynamicResource DangerBrush}" BorderThickness="0" Click="Clear_Click" />
                <Button Content="{DynamicResource Loc_DialogCancel}" Width="76" Height="38" IsCancel="True"
                        Background="{DynamicResource SectionBackgroundBrush}" Foreground="{DynamicResource PrimaryBrush}" BorderThickness="0" />
            </StackPanel>
        </Grid>
    </Border>
</Window>
