<Application x:Class="Hafiza.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             ShutdownMode="OnExplicitShutdown">
    <Application.Resources>
        <FontFamily x:Key="InterfaceFont">Tahoma, Segoe UI</FontFamily>
        <LinearGradientBrush x:Key="CanvasBrush" StartPoint="0,0" EndPoint="1,1">
            <GradientStop Color="#101C22" Offset="0" />
            <GradientStop Color="#0C141A" Offset="0.55" />
            <GradientStop Color="#11282B" Offset="1" />
        </LinearGradientBrush>
        <SolidColorBrush x:Key="PanelBrush" Color="#202326" />
        <SolidColorBrush x:Key="CardBrush" Color="#262626" />
        <SolidColorBrush x:Key="CardHoverBrush" Color="#2D2D2D" />
        <SolidColorBrush x:Key="PrimaryBrush" Color="#F4F7F6" />
        <SolidColorBrush x:Key="SecondaryBrush" Color="#AAB2B0" />
        <SolidColorBrush x:Key="AccentBrush" Color="#14DFC9" />
        <SolidColorBrush x:Key="DangerBrush" Color="#FF7B7B" />
        <SolidColorBrush x:Key="SurfaceBorderBrush" Color="#365058" />
        <SolidColorBrush x:Key="SectionBackgroundBrush" Color="#101D23" />
        <SolidColorBrush x:Key="SectionBorderBrush" Color="#233D44" />
        <SolidColorBrush x:Key="SearchBackgroundBrush" Color="#1A2B33" />
        <SolidColorBrush x:Key="SearchBorderBrush" Color="#35545D" />
        <SolidColorBrush x:Key="FolderCardBackgroundBrush" Color="#182C32" />
        <SolidColorBrush x:Key="FolderCardBorderBrush" Color="#33575C" />
        <SolidColorBrush x:Key="FolderAreaBackgroundBrush" Color="#1E2224" />
        <SolidColorBrush x:Key="FolderAreaBorderBrush" Color="#303638" />
        <SolidColorBrush x:Key="EmptyStateBackgroundBrush" Color="#101F25" />
        <SolidColorBrush x:Key="EmptyStateBorderBrush" Color="#263E45" />
        <SolidColorBrush x:Key="DragHandleBackgroundBrush" Color="#222628" />
        <SolidColorBrush x:Key="SettingsBackgroundBrush" Color="#17191B" />
        <SolidColorBrush x:Key="BadgeBackgroundBrush" Color="#243C3A" />
        <SolidColorBrush x:Key="IconBoxBackgroundBrush" Color="#123D40" />
        <SolidColorBrush x:Key="IconBoxBorderBrush" Color="#14DFC9" />
        <SolidColorBrush x:Key="CardBorderBrush" Color="#323638" />
        <SolidColorBrush x:Key="SearchHintBrush" Color="#79817F" />
        <SolidColorBrush x:Key="DragDotBrush" Color="#9AA5A2" />
        <SolidColorBrush x:Key="IconButtonForegroundBrush" Color="#AAB2B0" />
        <SolidColorBrush x:Key="IconButtonHoverBackgroundBrush" Color="#34383B" />
        <SolidColorBrush x:Key="IconButtonHoverForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="IconButtonSelectedBackgroundBrush" Color="#16463F" />
        <SolidColorBrush x:Key="PillBackgroundBrush" Color="#24282A" />
        <SolidColorBrush x:Key="PillForegroundBrush" Color="#AAB2B0" />
        <SolidColorBrush x:Key="PillHoverBackgroundBrush" Color="#343A3C" />
        <SolidColorBrush x:Key="PillHoverForegroundBrush" Color="#FFFFFF" />
        <SolidColorBrush x:Key="PillSelectedBackgroundBrush" Color="#184B40" />
        <SolidColorBrush x:Key="PillSelectedForegroundBrush" Color="#14DFC9" />
        <SolidColorBrush x:Key="CheckBoxBackgroundBrush" Color="#202527" />
        <SolidColorBrush x:Key="CheckBoxBorderBrush" Color="#87918E" />
        <SolidColorBrush x:Key="CheckBoxMarkBrush" Color="#10201C" />
        <SolidColorBrush x:Key="PinIconBrush" Color="#A4AEAB" />
        <SolidColorBrush x:Key="DeleteIconBrush" Color="#E8B4FF" />
        <SolidColorBrush x:Key="CopyIconBrush" Color="#9DEDE3" />
        <SolidColorBrush x:Key="CopyIconSecondaryBrush" Color="#72CFC4" />
        <SolidColorBrush x:Key="ThemeIconBrush" Color="#FFC83B" />

        <!-- Keep detached Windows popups consistent with the application's dark surface. -->
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuBrushKey}" Color="#222628" />
        <SolidColorBrush x:Key="{x:Static SystemColors.MenuTextBrushKey}" Color="#DDE5E2" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightBrushKey}" Color="#285249" />
        <SolidColorBrush x:Key="{x:Static SystemColors.HighlightTextBrushKey}" Color="#F5FFFC" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlBrushKey}" Color="#222628" />
        <SolidColorBrush x:Key="{x:Static SystemColors.ControlTextBrushKey}" Color="#DDE5E2" />

        <Style TargetType="TextBlock">
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
        </Style>

        <Style TargetType="Button">
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource FolderAreaBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource FolderAreaBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="10,6" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="ButtonSurface" Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="ButtonSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></Trigger>
                            <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource PillHoverBackgroundBrush}" /></Trigger>
                            <Trigger Property="IsPressed" Value="True"><Setter TargetName="ButtonSurface" Property="Background" Value="{DynamicResource PillSelectedBackgroundBrush}" /></Trigger>
                            <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" /><Setter TargetName="ButtonSurface" Property="Opacity" Value="0.5" /></Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="TextBox">
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SearchBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SearchBorderBrush}" />
            <Setter Property="CaretBrush" Value="{DynamicResource AccentBrush}" />
            <Setter Property="SelectionBrush" Value="{DynamicResource PillSelectedBackgroundBrush}" />
        </Style>

        <Style TargetType="ToolTip">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SectionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="9,6" />
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
            <Setter Property="FontSize" Value="12" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToolTip">
                        <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBox">
            <Setter Property="FontFamily" Value="{StaticResource InterfaceFont}" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource SearchBackgroundBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SearchBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="8,4" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBox">
                        <Grid FlowDirection="LeftToRight">
                            <Border x:Name="ComboSurface" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="34" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <Path Grid.Column="0" Data="M 2,3 L 6,7 L 10,3" Stroke="{DynamicResource SecondaryBrush}"
                                          StrokeThickness="1.7" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                          Width="12" Height="9" Stretch="Uniform" HorizontalAlignment="Center"
                                          VerticalAlignment="Center" />
                                    <ContentPresenter Grid.Column="1" Content="{TemplateBinding SelectionBoxItem}"
                                                      ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}"
                                                      Margin="{TemplateBinding Padding}" VerticalAlignment="Center"
                                                      HorizontalAlignment="Right" FlowDirection="RightToLeft"
                                                      TextElement.Foreground="{TemplateBinding Foreground}" />
                                </Grid>
                            </Border>
                            <ToggleButton Focusable="False" Background="Transparent" BorderThickness="0"
                                          IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}"
                                          ClickMode="Press" Opacity="0" />
                            <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}"
                                   Placement="Bottom" AllowsTransparency="True" Focusable="False"
                                   PopupAnimation="Fade">
                                <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SearchBorderBrush}" BorderThickness="1"
                                        CornerRadius="8" Margin="0,3,0,0"
                                        MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}">
                                    <ScrollViewer Margin="4" MaxHeight="260" CanContentScroll="True"
                                                  VerticalScrollBarVisibility="Auto">
                                        <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained" />
                                    </ScrollViewer>
                                </Border>
                            </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocusWithin" Value="True">
                                <Setter TargetName="ComboSurface" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ComboSurface" Property="Opacity" Value="0.55" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="Padding" Value="12,9" />
            <Setter Property="Margin" Value="0,1" />
            <Setter Property="HorizontalContentAlignment" Value="Right" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ComboBoxItem">
                        <Border x:Name="ItemSurface" Background="{TemplateBinding Background}" CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Right" VerticalAlignment="Center"
                                              FlowDirection="RightToLeft" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource PillHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PillHoverForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter TargetName="ItemSurface" Property="Background" Value="{DynamicResource PillSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PillSelectedForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter TargetName="ItemSurface" Property="Opacity" Value="0.5" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="CheckBox">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>

        <Style x:Key="CardSelectionCheck" TargetType="CheckBox">
            <Setter Property="Width" Value="24" />
            <Setter Property="Height" Value="24" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="FocusVisualStyle" Value="{x:Null}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="CheckBox">
                        <Grid>
                            <Border x:Name="SelectionBox" Width="20" Height="20" CornerRadius="5"
                                    Background="{DynamicResource CheckBoxBackgroundBrush}"
                                    BorderBrush="{DynamicResource CheckBoxBorderBrush}" BorderThickness="1.5" />
                            <Path x:Name="SelectionMark" Data="M4,10 L8,14 L16,6" Stroke="{DynamicResource CheckBoxMarkBrush}"
                                  StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round"
                                  Visibility="Collapsed" />
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="SelectionBox" Property="Background" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SelectionBox" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="SelectionMark" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="SelectionBox" Property="BorderThickness" Value="2" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="ContextMenu">
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="BorderBrush" Value="{DynamicResource SectionBorderBrush}" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="Padding" Value="5" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="HasDropShadow" Value="True" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ContextMenu">
                        <Border Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="18" ShadowDepth="6" Opacity="0.3" Color="Black" />
                            </Border.Effect>
                            <ScrollViewer CanContentScroll="True" VerticalScrollBarVisibility="Auto">
                                <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                            </ScrollViewer>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="MenuItem">
            <Setter Property="Foreground" Value="{DynamicResource PrimaryBrush}" />
            <Setter Property="Background" Value="{DynamicResource PanelBrush}" />
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Margin" Value="2" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="MenuItem">
                        <Grid>
                        <Border x:Name="MenuRow" Background="{TemplateBinding Background}" CornerRadius="7"
                                Padding="{TemplateBinding Padding}" TextElement.Foreground="{TemplateBinding Foreground}">
                            <Grid MinWidth="190">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="24" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock x:Name="CheckGlyph" Text="✓" Foreground="{DynamicResource AccentBrush}"
                                           FontSize="15" FontWeight="SemiBold" Visibility="Collapsed"
                                           HorizontalAlignment="Center" VerticalAlignment="Center" />
                                <ContentPresenter Grid.Column="1" ContentSource="Header" RecognizesAccessKey="True"
                                                  VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                        <Popup x:Name="PART_Popup" Placement="Left" HorizontalOffset="-2" AllowsTransparency="True"
                               IsOpen="{Binding IsSubmenuOpen, RelativeSource={RelativeSource TemplatedParent}}" Focusable="False">
                            <Border Background="{DynamicResource PanelBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1" CornerRadius="9" Padding="5">
                                <ScrollViewer MaxHeight="400" VerticalScrollBarVisibility="Auto" CanContentScroll="True">
                                    <ItemsPresenter KeyboardNavigation.DirectionalNavigation="Cycle" />
                                </ScrollViewer>
                            </Border>
                        </Popup>
                        </Grid>
                        <ControlTemplate.Triggers>
                            <Trigger Property="HasItems" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Text" Value="‹" />
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsHighlighted" Value="True">
                                <Setter TargetName="MenuRow" Property="Background" Value="{DynamicResource PillHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PillHoverForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="CheckGlyph" Property="Visibility" Value="Visible" />
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Foreground" Value="{DynamicResource SecondaryBrush}" />
                                <Setter TargetName="MenuRow" Property="Opacity" Value="0.72" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style TargetType="Separator">
            <Setter Property="Height" Value="1" />
            <Setter Property="Margin" Value="8,5" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Separator">
                        <Border Height="1" Background="{DynamicResource SectionBorderBrush}" />
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="IconButton" TargetType="Button">
            <Setter Property="MinWidth" Value="28" />
            <Setter Property="MinHeight" Value="28" />
            <Setter Property="Foreground" Value="{DynamicResource IconButtonForegroundBrush}" />
            <Setter Property="Background" Value="Transparent" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="9" />
            <Setter Property="FontSize" Value="17" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="bg" Background="{TemplateBinding Background}" CornerRadius="9">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource IconButtonSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                            </Trigger>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="bg" Property="Background" Value="{DynamicResource IconButtonHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource IconButtonHoverForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="IsKeyboardFocused" Value="True">
                                <Setter TargetName="bg" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="bg" Property="BorderThickness" Value="1" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="PillButton" TargetType="Button">
            <Setter Property="Foreground" Value="{DynamicResource PillForegroundBrush}" />
            <Setter Property="Background" Value="{DynamicResource PillBackgroundBrush}" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Padding" Value="14,8" />
            <Setter Property="FontFamily" Value="Segoe UI" />
            <Setter Property="FontSize" Value="14" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="pill" Background="{TemplateBinding Background}" CornerRadius="11" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource PillHoverBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PillHoverForegroundBrush}" />
                            </Trigger>
                            <Trigger Property="Tag" Value="selected">
                                <Setter TargetName="pill" Property="Background" Value="{DynamicResource PillSelectedBackgroundBrush}" />
                                <Setter Property="Foreground" Value="{DynamicResource PillSelectedForegroundBrush}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Application.Resources>
</Application>
