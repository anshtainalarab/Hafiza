<Window x:Class="Hafiza.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Hafiza.Models"
        xmlns:converters="clr-namespace:Hafiza.Converters"
        xmlns:sys="clr-namespace:System;assembly=mscorlib"
        Title="حافظة" Width="610" Height="735" MinWidth="430" MinHeight="480"
        WindowStyle="None" AllowsTransparency="True" Background="Transparent" ResizeMode="CanResize"
        ShowInTaskbar="False" Topmost="True" FlowDirection="RightToLeft"
        FontFamily="{StaticResource InterfaceFont}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        SourceInitialized="Window_SourceInitialized" Closing="Window_Closing"
        SizeChanged="Window_SizeChanged" PreviewKeyDown="Window_PreviewKeyDown" Icon="Assets/hafiza.ico">
    <Window.Resources>
        <converters:FileImageConverter x:Key="FileImageConverter" />
        <converters:BooleanToVisibilityConverter x:Key="BoolToVisibility" />
        <converters:MissingFileVisibilityConverter x:Key="MissingFileVisibility" />
        <sys:Double x:Key="PreviewHeight">95</sys:Double>
        <sys:Double x:Key="TextPreviewHeight">53</sys:Double>
        <Thickness x:Key="CardPadding">7</Thickness>
    </Window.Resources>

    <Border x:Name="RootShell" Margin="18" Background="{DynamicResource CanvasBrush}" BorderBrush="{DynamicResource SurfaceBorderBrush}"
            BorderThickness="1" CornerRadius="22">
        <Border.Effect>
            <DropShadowEffect BlurRadius="14" ShadowDepth="0" Opacity="0.06" Color="#13CFB9" />
        </Border.Effect>
        <Grid ClipToBounds="True">
            <Grid.RowDefinitions>
                <RowDefinition Height="74" />
                <RowDefinition Height="58" />
                <RowDefinition Height="58" />
                <RowDefinition Height="*" />
                <RowDefinition Height="42" />
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Margin="22,8,18,0" MouseLeftButtonDown="Header_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Width="44" Height="44" CornerRadius="12" Background="{DynamicResource IconBoxBackgroundBrush}" BorderBrush="{DynamicResource IconBoxBorderBrush}" BorderThickness="1" VerticalAlignment="Center">
                    <Path Data="M 8,4 L 13,4 13,7 8,7 Z M 6,5 L 4,5 4,21 17,21 17,5 15,5 M 7,11 L 14,11 M 7,15 L 12,15"
                          Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.5" Stretch="Uniform"
                          Width="21" Height="25" StrokeLineJoin="Round" />
                </Border>
                <StackPanel Grid.Column="1" Margin="12,0" VerticalAlignment="Center">
                    <TextBlock x:Name="AppTitleText" Text="Hafiza" FontSize="28" FontWeight="Bold" Foreground="{DynamicResource PrimaryBrush}" />
                    <TextBlock x:Name="AppSubtitleText" Text="Everything you copied, in one place" Foreground="{DynamicResource SecondaryBrush}" FontSize="12" />
                </StackPanel>
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" FlowDirection="LeftToRight">
                    <Button x:Name="SettingsButton" Style="{StaticResource IconButton}" ToolTip="Settings" Content="⚙" FontSize="17" Margin="3,0" Click="SettingsButton_Click" />
                    <Button x:Name="KeepOpenButton" Style="{StaticResource IconButton}" ToolTip="Keep window open after paste"
                            Margin="3,0" Click="KeepOpenButton_Click">
                        <Viewbox Width="16" Height="16">
                            <Canvas Width="24" Height="24">
                                <Path Data="M8,2 L16,2 L14,7 L14,10 L18,14 L18,16 L13,16 L13,22 L11,22 L11,16 L6,16 L6,14 L10,10 L10,7 Z"
                                      Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}">
                                    <Path.RenderTransform><RotateTransform Angle="-35" CenterX="12" CenterY="12" /></Path.RenderTransform>
                                </Path>
                            </Canvas>
                        </Viewbox>
                    </Button>
                    <Button x:Name="ThemeToggleButton" Style="{StaticResource IconButton}" ToolTip="Switch to Light Mode"
                            Margin="3,0" Click="ThemeToggle_Click">
                        <TextBlock x:Name="ThemeIconText" Text="☀️" FontSize="15" Foreground="{DynamicResource ThemeIconBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                    </Button>
                    <Button x:Name="LanguageToggleButton" Style="{StaticResource IconButton}" ToolTip="التبديل إلى العربية"
                            Margin="3,0" Click="LanguageToggle_Click">
                        <Border CornerRadius="6" Background="{DynamicResource BadgeBackgroundBrush}" Padding="5,2" MinWidth="26">
                            <TextBlock x:Name="LanguageBadgeText" Text="AR" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" HorizontalAlignment="Center" />
                        </Border>
                    </Button>
                    <Button x:Name="UndoDeleteButton" Style="{StaticResource IconButton}" ToolTip="Undo last delete"
                            Content="↶" FontSize="20" Margin="3,0" Visibility="Collapsed" Click="UndoDeleteButton_Click" />
                    <Button x:Name="SelectionModeButton" Style="{StaticResource IconButton}" ToolTip="Select multiple items"
                            Content="☐" FontSize="16" Margin="3,0" Click="SelectionModeButton_Click" />
                    <Button x:Name="PauseButton" Style="{StaticResource IconButton}" ToolTip="Pause capture"
                            Margin="3,0" Click="PauseButton_Click">
                        <Viewbox Width="15" Height="15"><Canvas Width="20" Height="20">
                            <Rectangle x:Name="PauseBarOne" Width="4" Height="14" RadiusX="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Canvas.Left="4" Canvas.Top="3" />
                            <Rectangle x:Name="PauseBarTwo" Width="4" Height="14" RadiusX="2" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Canvas.Left="12" Canvas.Top="3" />
                            <Path x:Name="ResumeGlyph" Data="M5,3 L16,10 L5,17 Z" Fill="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" Visibility="Collapsed" />
                        </Canvas></Viewbox>
                    </Button>
                    <Button x:Name="HideButton" Style="{StaticResource IconButton}" ToolTip="Hide" Content="×" FontSize="24" Margin="3,0" Click="HideButton_Click" />
                </StackPanel>
            </Grid>

            <Border Grid.Row="1" Background="{DynamicResource SectionBackgroundBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="0,1">
                <Grid Margin="18,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ScrollViewer HorizontalScrollBarVisibility="Hidden" VerticalScrollBarVisibility="Disabled">
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="AllTabButton" Content="All" Style="{StaticResource PillButton}"
                                    Margin="0,0,7,0" Tag="selected" Click="AllTab_Click" />
                            <ItemsControl x:Name="TabsControl" ItemsSource="{Binding PrimaryTabs}" AllowDrop="True"
                                          DragOver="TabsControl_DragOver" Drop="TabsControl_Drop">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ClipboardTab}">
                                        <Button Content="{Binding Name}" Style="{StaticResource PillButton}" Margin="0,0,7,0"
                                                Click="Tab_Click" MouseRightButtonUp="Tab_RightClick"
                                                PreviewMouseLeftButtonDown="Tab_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="Tab_PreviewMouseMove"
                                                ToolTip="Right-click to rename or delete" />
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <Button x:Name="MoreTabsButton" Content="•••" Style="{StaticResource PillButton}"
                                    Margin="0,0,7,0" Click="MoreTabsButton_Click"
                                    ToolTip="{DynamicResource Loc_MoreTabsTooltip}" Visibility="Collapsed" />
                        </StackPanel>
                    </ScrollViewer>
                    <Button Grid.Column="1" x:Name="NewTabButton" Content="＋" Style="{StaticResource IconButton}" Width="40" Height="40"
                            Margin="8,0,0,0" ToolTip="New tab" Click="NewTab_Click" />
                </Grid>
            </Border>

            <Grid Grid.Row="2" Margin="24,10,24,7">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Border Grid.Column="0" Background="{DynamicResource SearchBackgroundBrush}" CornerRadius="12" BorderBrush="{DynamicResource SearchBorderBrush}" BorderThickness="1">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="38" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="⌕" FontSize="21" Foreground="{DynamicResource SecondaryBrush}"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" />
                        <TextBox x:Name="SearchBox" Grid.Column="1" Background="Transparent" BorderThickness="0"
                                 Foreground="{DynamicResource PrimaryBrush}" CaretBrush="{DynamicResource AccentBrush}"
                                 VerticalContentAlignment="Center" FontSize="15" TextChanged="SearchBox_TextChanged"
                                 ToolTip="Search clipboard history" />
                        <TextBlock x:Name="SearchHint" Grid.Column="1" Text="Search clipboard…" IsHitTestVisible="False"
                                   VerticalAlignment="Center" Foreground="{DynamicResource SearchHintBrush}" FontSize="15" />
                        <Button Grid.Column="2" x:Name="SearchClearButton" Content="×" Width="30" Height="30"
                                Visibility="Collapsed" Style="{StaticResource IconButton}" ToolTip="Clear search"
                                Click="SearchClearButton_Click" />
                    </Grid>
                </Border>
                <Button Grid.Column="1" x:Name="NewFolderButton" Visibility="Collapsed" Width="44" Height="40"
                        Margin="8,0,0,0" Style="{StaticResource IconButton}" ToolTip="New folder"
                        Click="NewFolderButton_Click">
                    <Grid Width="23" Height="19">
                        <Path Data="M2,5 L2,17 L21,17 L21,6 L11,6 L9,3 L2,3 Z" Fill="#D6B663" />
                        <TextBlock Text="+" Foreground="#1A1C1E" FontSize="13" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,2,0,0" />
                    </Grid>
                </Button>
            </Grid>

            <Grid Grid.Row="3" Margin="18,2,18,0">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>
                <Border x:Name="FolderArea" Grid.Row="0" Visibility="Collapsed" Margin="2,0,2,7"
                        Background="{DynamicResource FolderAreaBackgroundBrush}" BorderBrush="{DynamicResource FolderAreaBorderBrush}" BorderThickness="1" CornerRadius="11" Padding="7">
                    <StackPanel x:Name="FolderBreadcrumb" Orientation="Horizontal">
                        <Button x:Name="FolderBackButton" Content="←" Style="{StaticResource IconButton}" Width="32" Height="30"
                                ToolTip="Back to tab" Click="FolderBack_Click" />
                        <TextBlock Text="📁" FontSize="17" VerticalAlignment="Center" Margin="5,0" />
                        <TextBlock x:Name="CurrentFolderName" FontSize="14" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button x:Name="FolderOptionsButton" Content="•••" Style="{StaticResource IconButton}" Width="32" Height="30"
                                Margin="5,0,0,0" ToolTip="Folder options" Click="FolderOptions_Click" />
                    </StackPanel>
                </Border>
                <ListBox Grid.Row="1" x:Name="HistoryList" ItemsSource="{Binding VisibleItems}" Background="Transparent"
                         BorderThickness="0" ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                         HorizontalContentAlignment="Stretch" AllowDrop="True" SelectionMode="Extended"
                         VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling"
                         VirtualizingPanel.ScrollUnit="Pixel"
                         ScrollViewer.CanContentScroll="True"
                         ScrollViewer.PanningMode="VerticalOnly"
                         ScrollViewer.PanningRatio="1"
                         ScrollViewer.PanningDeceleration="0.001"
                         PreviewMouseWheel="HistoryList_PreviewMouseWheel"
                         PreviewStylusDown="HistoryList_PreviewStylusDown"
                         PreviewStylusMove="HistoryList_PreviewStylusMove"
                         PreviewStylusUp="HistoryList_PreviewStylusUp"
                         PreviewMouseLeftButtonDown="HistoryList_PreviewMouseLeftButtonDown"
                         SelectionChanged="HistoryList_SelectionChanged"
                         DragOver="HistoryList_DragOver" Drop="HistoryList_Drop">
                    <ListBox.Resources>
                        <Style TargetType="ListBoxItem">
                            <Setter Property="Padding" Value="0" />
                            <Setter Property="Margin" Value="0,0,0,5" />
                            <Setter Property="Background" Value="Transparent" />
                            <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="ListBoxItem">
                                        <Grid>
                                            <Border x:Name="SelectionFrame" BorderThickness="2" BorderBrush="Transparent" CornerRadius="11">
                                                <ContentPresenter />
                                            </Border>
                                            <Border x:Name="BeforeDropCue" Height="3" Margin="10,-2,10,0"
                                                    CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Top" Visibility="Collapsed" Panel.ZIndex="2" />
                                            <Border x:Name="AfterDropCue" Height="3" Margin="10,0,10,-2"
                                                    CornerRadius="2" Background="{DynamicResource AccentBrush}"
                                                    VerticalAlignment="Bottom" Visibility="Collapsed" Panel.ZIndex="2" />
                                        </Grid>
                                        <ControlTemplate.Triggers>
                                            <Trigger Property="Tag" Value="drop-before">
                                                <Setter TargetName="BeforeDropCue" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="Tag" Value="drop-after">
                                                <Setter TargetName="AfterDropCue" Property="Visibility" Value="Visible" />
                                            </Trigger>
                                            <Trigger Property="IsSelected" Value="True">
                                                <Setter TargetName="SelectionFrame" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                            </Trigger>
                                        </ControlTemplate.Triggers>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    
                        <DataTemplate DataType="{x:Type models:ClipboardEntry}">
                            <Border x:Name="Card" Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource CardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="{DynamicResource CardPadding}"
                                    Cursor="Hand">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="92" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="42" />
                                    </Grid.ColumnDefinitions>
                                    <Grid Grid.Column="1" FlowDirection="RightToLeft">
                                        <TextBlock Text="{Binding Text}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="{DynamicResource TextPreviewHeight}" FontSize="19" LineHeight="29" Foreground="{DynamicResource PrimaryBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsText, Converter={StaticResource BoolToVisibility}}" />
                                        <TextBlock Text="{Binding DisplayText}" TextWrapping="Wrap" TextTrimming="CharacterEllipsis"
                                                   MaxHeight="{DynamicResource TextPreviewHeight}" FontSize="14" LineHeight="20" Foreground="{DynamicResource SecondaryBrush}" VerticalAlignment="Center"
                                                   Visibility="{Binding IsFiles, Converter={StaticResource BoolToVisibility}}" />
                                        <Border Background="#F4F5F2" CornerRadius="7" Width="238" Height="{DynamicResource PreviewHeight}" ClipToBounds="True"
                                                HorizontalAlignment="Right" VerticalAlignment="Center" UseLayoutRounding="True">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Collapsed" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding IsImage}" Value="True">
                                                             <Setter Property="Visibility" Value="Visible" />
                                                        </DataTrigger>
                                                        <DataTrigger Binding="{Binding IsImageMissing}" Value="True">
                                                            <Setter Property="Visibility" Value="Collapsed" />
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <Viewbox Margin="5" Stretch="Uniform" StretchDirection="Both"
                                                     HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                                     Cursor="Hand" ToolTip="{DynamicResource Loc_ImageClick}"
                                                     RenderOptions.BitmapScalingMode="HighQuality">
                                                <Image Source="{Binding DisplayImagePath, Converter={StaticResource FileImageConverter}}"
                                                       Stretch="None" FlowDirection="LeftToRight"
                                                       SnapsToDevicePixels="True" />
                                            </Viewbox>
                                        </Border>
                                        <Border Background="{DynamicResource SectionBackgroundBrush}" BorderBrush="{DynamicResource SectionBorderBrush}" BorderThickness="1" CornerRadius="7" Width="238" Height="{DynamicResource PreviewHeight}"
                                                HorizontalAlignment="Right" VerticalAlignment="Center"
                                                Visibility="{Binding Converter={StaticResource MissingFileVisibility}}">
                                            <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <TextBlock Text="⚠" FontSize="20" Foreground="#FFB08A" HorizontalAlignment="Center" />
                                                <TextBlock Text="{DynamicResource Loc_ImageMissing}" FontSize="12" Foreground="{DynamicResource SecondaryBrush}" Margin="0,4,0,0" />
                                            </StackPanel>
                                        </Border>
                                        <Border Background="{DynamicResource BadgeBackgroundBrush}" CornerRadius="6" Padding="6,2"
                                                HorizontalAlignment="Left" VerticalAlignment="Top" IsHitTestVisible="False">
                                            <Border.Style>
                                                <Style TargetType="Border">
                                                    <Setter Property="Visibility" Value="Visible" />
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding Label}" Value=""><Setter Property="Visibility" Value="Collapsed" /></DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </Border.Style>
                                            <TextBlock Text="{Binding Label}" FontSize="10" Foreground="{DynamicResource AccentBrush}" MaxWidth="210" TextTrimming="CharacterEllipsis" />
                                        </Border>
                                    </Grid>
                                    <Grid Grid.Column="0" Width="88" Height="56" VerticalAlignment="Center" FlowDirection="RightToLeft">
                                        <Grid.RowDefinitions>
                                            <RowDefinition Height="28" />
                                            <RowDefinition Height="28" />
                                        </Grid.RowDefinitions>
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                            <Button Style="{StaticResource IconButton}" Width="28" Height="28"
                                                    ToolTip="{DynamicResource Loc_CardPin}" Click="PinButton_Click">
                                                <Viewbox Width="16" Height="16">
                                                    <Canvas Width="24" Height="24">
                                                        <Path Data="M8,2 L16,2 L14,7 L14,10 L18,14 L18,16 L13,16 L13,22 L11,22 L11,16 L6,16 L6,14 L10,10 L10,7 Z"
                                                              RenderTransformOrigin="0.5,0.5">
                                                              <Path.RenderTransform>
                                                                  <RotateTransform Angle="-35" />
                                                              </Path.RenderTransform>
                                                              <Path.Style>
                                                                  <Style TargetType="Path">
                                                                      <Setter Property="Fill" Value="{DynamicResource PinIconBrush}" />
                                                                      <Style.Triggers>
                                                                          <DataTrigger Binding="{Binding IsPinnedInActiveTab}" Value="True">
                                                                              <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                                          </DataTrigger>
                                                                      </Style.Triggers>
                                                                  </Style>
                                                              </Path.Style>
                                                        </Path>
                                                    </Canvas>
                                                </Viewbox>
                                            </Button>
                                            <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Loc_CardDelete}" Click="DeleteButton_Click">
                                                <Path Data="M7,8 L17,8 M9,8 L10,20 L16,20 L17,8 M10,5 L16,5 L17,8 L9,8 Z M12,11 L12,17 M15,11 L15,17"
                                                      Stroke="{DynamicResource DeleteIconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Button>
                                            <Button Content="•••" Style="{StaticResource IconButton}" Width="28" Height="28" FontSize="11"
                                                    ToolTip="{DynamicResource Loc_CardMore}" Click="MoreButton_Click" />
                                        </StackPanel>
                                        <Border Grid.Row="1" Width="84" Height="26" CornerRadius="7" Cursor="SizeNS"
                                                Background="{DynamicResource DragHandleBackgroundBrush}" ToolTip="{DynamicResource Loc_CardDrag}" Tag="drag-handle"
                                                PreviewMouseLeftButtonDown="DragHandle_PreviewMouseLeftButtonDown"
                                                PreviewMouseMove="DragHandle_PreviewMouseMove"
                                                PreviewMouseLeftButtonUp="DragHandle_PreviewMouseLeftButtonUp">
                                            <UniformGrid Rows="2" Columns="3" Width="18" Height="10"
                                                         HorizontalAlignment="Center" VerticalAlignment="Center">
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource DragDotBrush}" />
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource DragDotBrush}" />
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource DragDotBrush}" />
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource DragDotBrush}" />
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource DragDotBrush}" />
                                                <Ellipse Width="3" Height="3" Fill="{DynamicResource DragDotBrush}" />
                                            </UniformGrid>
                                        </Border>
                                    </Grid>
                                    <StackPanel Grid.Column="2" VerticalAlignment="Top" HorizontalAlignment="Center" FlowDirection="RightToLeft">
                                    <CheckBox Style="{StaticResource CardSelectionCheck}" Margin="0,0,0,3"
                                              Panel.ZIndex="6" ToolTip="{DynamicResource Loc_CardSelect}"
                                              IsChecked="{Binding IsSelected, RelativeSource={RelativeSource AncestorType=ListBoxItem}, Mode=TwoWay}"
                                              Click="CardSelectionCheck_Click" />
                                    <Button Style="{StaticResource IconButton}" Width="28" Height="26" Padding="7.5" Panel.ZIndex="6" ToolTip="{DynamicResource Loc_CardCopy}"
                                            Click="CopyCard_Click">
                                        <Viewbox Stretch="Uniform">
                                            <Canvas Width="22" Height="22">
                                                <Path Data="M8,7 L18,7 Q20,7 20,9 L20,19 Q20,21 18,21 L8,21 Q6,21 6,19 L6,9 Q6,7 8,7 Z" Stroke="{DynamicResource CopyIconBrush}" StrokeThickness="1.65" Fill="Transparent" />
                                                <Path Data="M4,16 L4,5 Q4,3 6,3 L16,3" Stroke="{DynamicResource CopyIconSecondaryBrush}" StrokeThickness="1.65" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                            </Canvas>
                                        </Viewbox>
                                    </Button>
                                    <Button Content="↩" Margin="0,3,0,0" Width="32" Height="28" Panel.ZIndex="6" ToolTip="{DynamicResource Loc_CardReturnToTab}"
                                            Visibility="{Binding IsInsideFolder, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}"
                                            Click="ReturnCardToTab_Click" />
                                    </StackPanel>
                                </Grid>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Card" Property="IsMouseOver" Value="True">
                                    <Setter TargetName="Card" Property="Background" Value="{DynamicResource CardHoverBrush}" />
                                </Trigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                        <DataTemplate DataType="{x:Type models:ClipboardFolder}">
                            <Border Background="{DynamicResource FolderCardBackgroundBrush}" BorderBrush="{DynamicResource FolderCardBorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                <Grid FlowDirection="LeftToRight">
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="Auto"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <CheckBox Style="{StaticResource CardSelectionCheck}" IsChecked="{Binding IsSelected, Mode=TwoWay}" ToolTip="{DynamicResource Loc_CardSelect}" />
                                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Loc_FolderDelete}" Click="FolderDelete_Click">
                                            <Path Data="M7,8 L17,8 M9,8 L10,20 L16,20 L17,8 M10,5 L16,5 L17,8 L9,8 Z M12,11 L12,17 M15,11 L15,17"
                                                  Stroke="{DynamicResource DeleteIconBrush}" StrokeThickness="1.8" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" ToolTip="{DynamicResource Loc_FolderPin}" Click="FolderPin_Click">
                                            <Path Data="M8,2 L16,2 L14,7 L14,10 L18,14 L18,16 L13,16 L13,22 L11,22 L11,16 L6,16 L6,14 L10,10 L10,7 Z" Width="13" Height="16" Stretch="Uniform">
                                                <Path.Style><Style TargetType="Path"><Setter Property="Fill" Value="{DynamicResource PinIconBrush}"/><Style.Triggers><DataTrigger Binding="{Binding IsPinned}" Value="True"><Setter Property="Fill" Value="{DynamicResource AccentBrush}"/></DataTrigger></Style.Triggers></Style></Path.Style>
                                            </Path>
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Padding="6" ToolTip="{DynamicResource Loc_FolderCopy}" Click="FolderCopy_Click">
                                            <Path Data="M8,7 L18,7 Q20,7 20,9 L20,19 Q20,21 18,21 L8,21 Q6,21 6,19 L6,9 Q6,7 8,7 Z M4,16 L4,5 Q4,3 6,3 L16,3"
                                                  Stroke="{DynamicResource CopyIconBrush}" StrokeThickness="1.6" Fill="Transparent" StrokeStartLineCap="Round" StrokeEndLineCap="Round" />
                                        </Button>
                                        <Button Style="{StaticResource IconButton}" Width="28" Height="28" Content="•••" FontSize="11" Click="FolderMore_Click" ToolTip="{DynamicResource Loc_FolderOptions}" />
                                         <Border Width="30" Height="28" CornerRadius="7" Background="{DynamicResource DragHandleBackgroundBrush}" Cursor="SizeAll" Tag="folder-drag-handle" Margin="3,0,1,0"
                                                 PreviewMouseLeftButtonDown="FolderDrag_PreviewMouseLeftButtonDown" PreviewMouseMove="FolderDrag_PreviewMouseMove"
                                                 PreviewMouseLeftButtonUp="FolderDrag_PreviewMouseLeftButtonUp" ToolTip="{DynamicResource Loc_FolderDrag}">
                                             <Border.Style>
                                                 <Style TargetType="Border">
                                                     <Setter Property="BorderBrush" Value="{DynamicResource SectionBorderBrush}"/>
                                                     <Setter Property="BorderThickness" Value="1"/>
                                                     <Style.Triggers>
                                                         <Trigger Property="IsMouseOver" Value="True">
                                                             <Setter Property="Background" Value="{DynamicResource PillHoverBackgroundBrush}"/>
                                                             <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}"/>
                                                         </Trigger>
                                                     </Style.Triggers>
                                                 </Style>
                                             </Border.Style>
                                             <TextBlock Text="⠿" Foreground="{DynamicResource DragDotBrush}" FontSize="16" HorizontalAlignment="Center" VerticalAlignment="Center" />
                                         </Border>
                                    </StackPanel>
                                    <Button Grid.Column="1" Style="{StaticResource PillButton}" Margin="7,0" Click="Folder_Click"
                                            FlowDirection="RightToLeft" AllowDrop="True"
                                            DragOver="Folder_DragOver" Drop="Folder_Drop"
                                            ToolTip="{DynamicResource Loc_FolderPill}">
                                        <StackPanel Orientation="Horizontal"><TextBlock Text="📁" Margin="0,0,7,0"/><TextBlock Text="{Binding Name}" FontWeight="SemiBold"/></StackPanel>
                                    </Button>
                                    <Button Grid.Column="2" Style="{StaticResource IconButton}" Width="32" Height="32" Click="FolderExpand_Click" ToolTip="{DynamicResource Loc_FolderExpand}">
                                        <TextBlock Text="⌄" FontSize="19"><TextBlock.Style><Style TargetType="TextBlock"><Setter Property="RenderTransformOrigin" Value="0.5,0.5"/><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="0"/></Setter.Value></Setter><Style.Triggers><DataTrigger Binding="{Binding IsExpanded}" Value="True"><Setter Property="RenderTransform"><Setter.Value><RotateTransform Angle="180"/></Setter.Value></Setter></DataTrigger></Style.Triggers></Style></TextBlock.Style></TextBlock>
                                    </Button>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ListBox.Resources>
                </ListBox>

                <Border Grid.Row="1" x:Name="EmptyState" Background="{DynamicResource EmptyStateBackgroundBrush}" BorderBrush="{DynamicResource EmptyStateBorderBrush}" BorderThickness="1" CornerRadius="16" Margin="6,8" Visibility="Collapsed">
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" Width="280">
                        <Border Background="{DynamicResource IconBoxBackgroundBrush}" BorderBrush="{DynamicResource IconBoxBorderBrush}" BorderThickness="1.5" CornerRadius="19" Padding="25" HorizontalAlignment="Center" Margin="0,0,0,24">
                            <Border.Effect><DropShadowEffect Color="#14DFC9" BlurRadius="32" ShadowDepth="0" Opacity="0.3" /></Border.Effect>
                            <Path Data="M8,4 L18,4 18,9 8,9 Z M6,6 L2,6 2,36 24,36 24,6 20,6 M7,17 L19,17 M7,23 L19,23 M7,29 L16,29" Width="60" Height="82" Stretch="Uniform" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2" StrokeLineJoin="Round" />
                        </Border>
                        <TextBlock x:Name="EmptyTitle" Text="{DynamicResource Loc_EmptyTitle}" FontSize="18" FontWeight="SemiBold"
                                   HorizontalAlignment="Center" Margin="0,10,0,5" />
                        <TextBlock x:Name="EmptySubtitle" Text="{DynamicResource Loc_EmptySubtitle}" Foreground="{DynamicResource SecondaryBrush}"
                                   TextAlignment="Center" TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>

            <Grid Grid.Row="4" Margin="23,0" FlowDirection="LeftToRight">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Button Grid.Column="0" x:Name="ClearButton" Content="{DynamicResource Loc_ClearUnpinned}"
                        HorizontalAlignment="Left" VerticalAlignment="Center"
                        Foreground="{DynamicResource SecondaryBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        FontSize="12" Click="ClearButton_Click" />
                <TextBlock Grid.Column="1" x:Name="StatusText" Text="{DynamicResource Loc_StatusActive}" Foreground="{DynamicResource SecondaryBrush}"
                           FontSize="12" VerticalAlignment="Center" HorizontalAlignment="Right" />
                <StackPanel Grid.Column="1" x:Name="BulkActions" Visibility="Collapsed" Orientation="Horizontal"
                            HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button x:Name="BulkMoveButton" Content="{DynamicResource Loc_BulkMove}" Margin="4,0" Padding="7,3" Click="BulkMove_Click" />
                </StackPanel>
                <Button Grid.Column="2" x:Name="ErrorButton" Content="{DynamicResource Loc_ErrorButton}" Visibility="Collapsed"
                        Foreground="{DynamicResource DangerBrush}" Background="Transparent" BorderThickness="0" Cursor="Hand"
                        FontSize="11" Margin="8,0,0,0" Click="ErrorButton_Click" />
            </Grid>
        </Grid>
    </Border>
</Window>
