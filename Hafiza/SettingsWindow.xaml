<Window x:Class="Hafiza.SettingsWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="{DynamicResource Loc_SettingsTitle}"
        Width="460" Height="720" WindowStartupLocation="CenterOwner" ResizeMode="NoResize"
        Background="{DynamicResource SettingsBackgroundBrush}" Foreground="{DynamicResource PrimaryBrush}"
        FontFamily="{StaticResource InterfaceFont}" TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="28">
            <TextBlock Text="{DynamicResource Loc_SettingsTitle}" FontSize="24" FontWeight="SemiBold" Margin="0,0,0,22" />
            
            <TextBlock Text="{DynamicResource Loc_SettingsLanguage}" Foreground="{DynamicResource SecondaryBrush}" />
            <ComboBox x:Name="LanguageBox" Margin="0,7,0,16" Height="36">
                <ComboBoxItem Tag="en" Content="{DynamicResource Loc_LangEnglish}" />
                <ComboBoxItem Tag="ar" Content="{DynamicResource Loc_LangArabic}" />
            </ComboBox>

            <TextBlock Text="{DynamicResource Loc_SettingsTheme}" Foreground="{DynamicResource SecondaryBrush}" />
            <ComboBox x:Name="ThemeBox" Margin="0,7,0,16" Height="36">
                <ComboBoxItem Tag="dark" Content="{DynamicResource Loc_ThemeDark}" />
                <ComboBoxItem Tag="light" Content="{DynamicResource Loc_ThemeLight}" />
            </ComboBox>

            <TextBlock Text="{DynamicResource Loc_SettingsMaxEntries}" Foreground="{DynamicResource SecondaryBrush}" />
            <TextBox x:Name="MaxEntriesBox" Margin="0,7,0,16" Height="36" Padding="10,6" />

            <TextBlock Text="{DynamicResource Loc_SettingsCardDensity}" Foreground="{DynamicResource SecondaryBrush}" />
            <ComboBox x:Name="DensityBox" Margin="0,7,0,16" Height="36">
                <ComboBoxItem Tag="compact" Content="{DynamicResource Loc_DensityCompact}" />
                <ComboBoxItem Tag="medium" Content="{DynamicResource Loc_DensityMedium}" />
                <ComboBoxItem Tag="large" Content="{DynamicResource Loc_DensityLarge}" />
            </ComboBox>

            <TextBlock Text="{DynamicResource Loc_SettingsWindowPosition}" Foreground="{DynamicResource SecondaryBrush}" />
            <ComboBox x:Name="PositionBox" Margin="0,7,0,16" Height="36">
                <ComboBoxItem Tag="bottom-right" Content="{DynamicResource Loc_PositionBottomRight}" />
                <ComboBoxItem Tag="bottom-left" Content="{DynamicResource Loc_PositionBottomLeft}" />
                <ComboBoxItem Tag="center" Content="{DynamicResource Loc_PositionCenter}" />
            </ComboBox>

            <TextBlock Text="{DynamicResource Loc_SettingsHotkey}" Foreground="{DynamicResource SecondaryBrush}" />
            <TextBox x:Name="HotKeyBox" Margin="0,7,0,16" Height="38" Padding="10,7"
                     IsReadOnly="True" Cursor="Hand" HorizontalContentAlignment="Center"
                     ToolTip="{DynamicResource Loc_SettingsHotkeyTooltip}" PreviewKeyDown="HotKeyBox_PreviewKeyDown" />

            <CheckBox x:Name="AnimationsBox" Content="{DynamicResource Loc_SettingsAnimations}" Margin="0,5" />
            <CheckBox x:Name="StartupBox" Content="{DynamicResource Loc_SettingsStartup}" Margin="0,5" />
            <CheckBox x:Name="BootCleanupBox" Content="{DynamicResource Loc_SettingsBootCleanup}" Margin="0,5,0,3"
                      IsEnabled="False" ToolTip="{DynamicResource Loc_SettingsBootCleanupTip}" />
            <TextBlock Text="{DynamicResource Loc_SettingsBootCleanupHint}"
                       Foreground="{DynamicResource SecondaryBrush}" FontSize="11" TextWrapping="Wrap" Margin="26,0,0,18" />

            <UniformGrid Columns="2" Margin="0,0,0,18">
                <Button Content="{DynamicResource Loc_SettingsExport}" Height="38" Margin="0,0,4,0" Click="Export_Click" />
                <Button Content="{DynamicResource Loc_SettingsImport}" Height="38" Margin="4,0,0,0" Click="Import_Click" />
            </UniformGrid>
            <TextBlock x:Name="NoticeText" Foreground="{DynamicResource AccentBrush}" TextWrapping="Wrap" Margin="0,0,0,12" />
            <Button Content="{DynamicResource Loc_SettingsSave}" Height="42" Background="{DynamicResource PillSelectedBackgroundBrush}" Foreground="{DynamicResource PillSelectedForegroundBrush}"
                    FontWeight="SemiBold" Click="Save_Click" />
        </StackPanel>
    </ScrollViewer>
</Window>
